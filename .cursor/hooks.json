{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "flipper-cursor-buddy/scripts/on-session-start.sh",
        "timeout": 120
      }
    ],
    "sessionEnd": [
      {
        "command": "flipper-cursor-buddy/scripts/on-session-end.sh"
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "flipper-cursor-buddy/scripts/on-prompt-submit.sh"
      }
    ],
    "preToolUse": [
      {
        "command": "python3 flipper-cursor-buddy/scripts/on-permission-request.py",
        "timeout": 65
      }
    ],
    "postToolUse": [
      {
        "command": "python3 flipper-cursor-buddy/scripts/on-post-tool-use.py"
      }
    ],
    "postToolUseFailure": [
      {
        "command": "python3 flipper-cursor-buddy/scripts/on-post-tool-use-failure.py"
      }
    ],
    "preCompact": [
      {
        "command": "python3 flipper-cursor-buddy/scripts/on-pre-compact.py"
      }
    ],
    "subagentStart": [
      {
        "command": "python3 flipper-cursor-buddy/scripts/on-subagent-start.py"
      }
    ],
    "subagentStop": [
      {
        "command": "python3 flipper-cursor-buddy/scripts/on-subagent-stop.py"
      }
    ],
    "stop": [
      {
        "command": "flipper-cursor-buddy/scripts/on-stop.sh"
      }
    ]
  }
}
